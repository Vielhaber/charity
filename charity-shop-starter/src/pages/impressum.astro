---
import Base from "../layouts/Base.astro";
---

<Base title="Impressum — Dein Charity-Shop">
  <h1>Impressum</h1>
  <p><strong>Platzhalter — vor Launch mit echten Angaben ersetzen.</strong></p>
  <p>
    Angaben gemäß § 5 DDG (Deutschland) bzw. § 5 ECG (Österreich):<br />
    [Name / Vereinsname]<br />
    [Straße, Hausnummer]<br />
    [PLZ, Ort]<br />
    [Land]
  </p>
  <p>
    Vertreten durch: [Name der vertretungsberechtigten Person(en)]<br />
    Vereinsregisternummer / Firmenbuchnummer: [falls zutreffend]<br />
    USt-IdNr.: [falls vorhanden] oder Hinweis auf Kleinunternehmerregelung
  </p>
  <p>
    Kontakt:<br />
    E-Mail: [kontakt@beispiel.de]<br />
    Telefon: [optional]
  </p>
</Base>
