---
import SpendenBadge from "./SpendenBadge.astro";

interface Props {
  title: string;
  preis: number;
  waehrung: string;
  spendenanteilProzent: number;
  stripeLink: string;
  bild?: string;
  verkauft?: boolean;
}
const { title, preis, waehrung, spendenanteilProzent, stripeLink, bild, verkauft } =
  Astro.props;
---

<article class="produkt-karte">
  {bild && <img src={bild} alt={title} loading="lazy" />}
  <div class="inhalt">
    <h3>{title}</h3>
    <p class="preis">{preis.toFixed(2)} {waehrung}</p>
    <SpendenBadge preis={preis} waehrung={waehrung} spendenanteilProzent={spendenanteilProzent} />
    {
      verkauft ? (
        <p class="verkauft">Bereits verkauft — dieses Unikat ist vergriffen</p>
      ) : (
        <a class="kaufen" href={stripeLink} target="_blank" rel="noopener">
          Jetzt kaufen
        </a>
      )
    }
  </div>
</article>

<style>
  .produkt-karte {
    border: 1px solid #dce2d7;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .produkt-karte img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .inhalt {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .inhalt h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .preis {
    margin: 0;
    font-weight: 700;
    color: #1b241e;
  }
  .kaufen {
    margin-top: 6px;
    display: inline-block;
    text-align: center;
    background: #3f6b4f;
    color: #fff;
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 8px;
    font-weight: 600;
  }
  .verkauft {
    margin-top: 6px;
    font-size: 0.85rem;
    color: #8a9389;
    font-style: italic;
  }
</style>
