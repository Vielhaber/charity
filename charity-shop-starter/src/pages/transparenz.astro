---
import Base from "../layouts/Base.astro";
import ImpactTracker from "../components/ImpactTracker.astro";
import { getCollection } from "astro:content";

const belege = (await getCollection("belege")).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf()
);
---

<Base title="Transparenzbericht — Dein Charity-Shop">
  <h1>Transparenzbericht</h1>
  <p class="intro">
    Hier findest du jede Überweisung an unsere Partnerorganisation –
    Kontodaten sind aus Datenschutzgründen geschwärzt, Betrag und Datum sind
    vollständig einsehbar.
  </p>

  <ImpactTracker />

  <ul class="belege">
    {
      belege.map((b) => (
        <li>
          <span class="datum">
            {b.data.datum.toLocaleDateString("de-DE", {
              day: "2-digit",
              month: "long",
              year: "numeric",
            })}
          </span>
          <span class="betrag">{b.data.betrag.toFixed(2)} €</span>
          <span class="empfaenger">an {b.data.empfaenger}</span>
          {b.data.belegDatei && (
            <a href={b.data.belegDatei} target="_blank" rel="noopener">
              Beleg ansehen
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <style>
    .intro {
      max-width: 65ch;
      color: #57635b;
    }
    .belege {
      list-style: none;
      padding: 0;
      margin-top: 32px;
    }
    .belege li {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: baseline;
      padding: 14px 0;
      border-bottom: 1px solid #dce2d7;
    }
    .datum {
      color: #8a9389;
      font-size: 0.85rem;
      min-width: 140px;
    }
    .betrag {
      font-weight: 700;
    }
    .belege a {
      margin-left: auto;
      color: #3f6b4f;
    }
  </style>
</Base>
