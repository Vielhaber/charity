---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Handgemachte Unikate – 100% im Sinne des guten Zwecks." } =
  Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={import.meta.env.BASE_URL}>Dein Charity-Shop</a>
      <nav>
        <a href={`${import.meta.env.BASE_URL}shop/`}>Shop</a>
        <a href={`${import.meta.env.BASE_URL}transparenz/`}>Transparenz</a>
        <a href={`${import.meta.env.BASE_URL}impressum/`}>Impressum</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href={`${import.meta.env.BASE_URL}impressum/`}>Impressum</a>
      <a href={`${import.meta.env.BASE_URL}datenschutz/`}>Datenschutz</a>
    </footer>
    <style is:global>
      body {
        font-family: "Karla", system-ui, sans-serif;
        margin: 0;
        color: #1b241e;
        background: #fff;
      }
      .site-header,
      .site-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px clamp(16px, 4vw, 48px);
        border-bottom: 1px solid #dce2d7;
      }
      .site-footer {
        border-top: 1px solid #dce2d7;
        border-bottom: none;
        margin-top: 60px;
      }
      .site-header nav a,
      .site-footer a {
        margin-left: 18px;
        color: #57635b;
        text-decoration: none;
      }
      .logo {
        font-weight: 700;
        color: #1b241e;
        text-decoration: none;
      }
      main {
        padding: 32px clamp(16px, 4vw, 48px) 60px;
        max-width: 1080px;
        margin: 0 auto;
      }
    </style>
  </body>
</html>
