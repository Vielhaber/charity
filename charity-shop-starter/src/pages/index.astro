---
import Base from "../layouts/Base.astro";
import ImpactTracker from "../components/ImpactTracker.astro";
import ProduktKarte from "../components/ProduktKarte.astro";
import { getCollection } from "astro:content";

const produkte = (await getCollection("produkte")).slice(0, 3);
---

<Base title="Dein Charity-Shop — handgemachte Unikate für den guten Zweck">
  <section class="hero">
    <h1>Handgemachte Unikate. Voller Einsatz für den guten Zweck.</h1>
    <p>
      Jedes Stück in diesem Shop ist ein Einzelstück – von Hand gefertigt. Ein
      Teil jedes Verkaufspreises geht direkt an eine gemeinnützige
      Organisation. Transparent nachvollziehbar, Beleg für Beleg.
    </p>
  </section>

  <ImpactTracker />

  <section class="teaser">
    <h2>Aktuelle Stücke</h2>
    <div class="grid">
      {
        produkte.map((p) => (
          <ProduktKarte
            title={p.data.title}
            preis={p.data.preis}
            waehrung={p.data.waehrung}
            spendenanteilProzent={p.data.spendenanteilProzent}
            stripeLink={p.data.stripeLink}
            bild={p.data.bild}
            verkauft={p.data.verkauft}
          />
        ))
      }
    </div>
    <a class="alle" href={`${import.meta.env.BASE_URL}shop/`}>Alle Stücke ansehen →</a>
  </section>

  <style>
    .hero {
      max-width: 62ch;
      margin-bottom: 32px;
    }
    .hero h1 {
      font-size: clamp(1.8rem, 4vw, 2.4rem);
      margin-bottom: 12px;
    }
    .teaser {
      margin-top: 48px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin: 20px 0;
    }
    .alle {
      color: #3f6b4f;
      font-weight: 600;
      text-decoration: none;
    }
  </style>
</Base>
