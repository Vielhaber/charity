---
interface Props {
  preis: number;
  waehrung: string;
  spendenanteilProzent: number;
}
const { preis, waehrung, spendenanteilProzent } = Astro.props;
const spendenBetrag = ((preis * spendenanteilProzent) / 100).toFixed(2);
---

<span class="spenden-badge">
  Dieser Artikel finanziert {spendenBetrag} {waehrung} · {spendenanteilProzent}% des Preises
</span>

<style>
  .spenden-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 99px;
    background: #f3e3cc;
    color: #c1791e;
  }
</style>
